import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../../core/themes/app_colors.dart';
import '../../core/widgets/brawe_logo.dart';
import '../../../domain/models/post.dart';
import '../../../data/repositories/auth_state_provider.dart';
import '../../../data/repositories/social_repository.dart';
import '../../../data/services/social_actions_service.dart';
import '../view_models/feed_view_model.dart';
import 'comments_sheet.dart';
import 'create_post_sheet.dart';
import 'story_composer_screen.dart';
import 'share_to_chat_sheet.dart';
import 'stories_rail.dart';

class FeedScreen extends ConsumerStatefulWidget {
  const FeedScreen({super.key});

  @override
  ConsumerState<FeedScreen> createState() => _FeedScreenState();
}

class _FeedScreenState extends ConsumerState<FeedScreen>
    with TickerProviderStateMixin {
  late TabController _tabController;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: 2, vsync: this);
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.nearBlack,
      body: SafeArea(
        child: Column(
          children: [
            _FeedTopBar(
              onCreatePost: () => showModalBottomSheet(
                context: context,
                isScrollControlled: true,
                backgroundColor: Colors.transparent,
                builder: (_) => const CreatePostSheet(),
              ),
            ),
            TabBar(
              controller: _tabController,
              indicatorColor: AppColors.electricPurple,
              indicatorWeight: 2,
              labelColor: Colors.white,
              unselectedLabelColor: AppColors.coolGray,
              labelStyle: const TextStyle(
                fontWeight: FontWeight.bold,
                fontSize: 14,
              ),
              tabs: const [
                Tab(text: 'Para Você'),
                Tab(text: 'Seguindo'),
              ],
            ),
            Expanded(
              child: TabBarView(
                controller: _tabController,
                children: [
                  _FeedTab(tabType: FeedTabType.forYou),
                  _FeedTab(tabType: FeedTabType.following),
                ],
              ),
            ),
          ],
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => showModalBottomSheet(
          context: context,
          isScrollControlled: true,
          backgroundColor: Colors.transparent,
          builder: (_) => const CreatePostSheet(),
        ),
        backgroundColor: AppColors.electricPurple,
        child: const Icon(Icons.add, color: Colors.white),
      ),
    );
  }
}

class _FeedTopBar extends StatelessWidget {
  const _FeedTopBar({required this.onCreatePost});
  final VoidCallback onCreatePost;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
      child: Row(
        children: [
          const BraweLogo(iconSize: 32),
          const Spacer(),
          IconButton(
            icon: const Icon(Icons.search, color: Colors.white),
            onPressed: () => context.push('/explore'),
          ),
          IconButton(
            icon: const Icon(Icons.notifications_none, color: Colors.white),
            onPressed: () => context.push('/notifications'),
          ),
        ],
      ),
    );
  }
}

enum FeedTabType { forYou, following }

class _FeedTab extends ConsumerWidget {
  const _FeedTab({required this.tabType});
  final FeedTabType tabType;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final feedState = ref.watch(feedViewModelProvider);

    return feedState.when(
      data: (posts) => CustomScrollView(
        slivers: [
          const SliverToBoxAdapter(child: StoriesRail()),
          const SliverToBoxAdapter(
            child: Divider(color: Colors.white10, height: 1),
          ),
          if (posts.isEmpty)
            const SliverFillRemaining(
              child: Center(
                child: Text(
                  'Nenhum post ainda.\nSeja o primeiro!',
                  textAlign: TextAlign.center,
                  style: TextStyle(color: AppColors.coolGray, fontSize: 16),
                ),
              ),
            )
          else
            SliverList(
              delegate: SliverChildBuilderDelegate(
                (context, index) => PostCard(post: posts[index]),
                childCount: posts.length,
              ),
            ),
          const SliverToBoxAdapter(child: SizedBox(height: 80)),
        ],
      ),
      loading: () => const Center(
        child: CircularProgressIndicator(color: AppColors.electricPurple),
      ),
      error: (_, __) => Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.wifi_off, color: AppColors.coolGray, size: 48),
            const SizedBox(height: 12),
            const Text(
              'Falha ao carregar o feed.',
              style: TextStyle(color: Colors.white),
            ),
            const SizedBox(height: 12),
            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: AppColors.electricPurple,
              ),
              onPressed: () =>
                  ref.read(feedViewModelProvider.notifier).refresh(),
              child: const Text('Tentar novamente'),
            ),
          ],
        ),
      ),
    );
  }
}


// ─── Post Card ────────────────────────────────────────────────────────────────

class PostCard extends ConsumerStatefulWidget {
  const PostCard({super.key, required this.post});
  final Post post;

  @override
  ConsumerState<PostCard> createState() => _PostCardState();
}

class _PostCardState extends ConsumerState<PostCard>
    with SingleTickerProviderStateMixin {
  late AnimationController _heartController;
  late Animation<double> _heartScale;
  bool _showHeart = false;

  @override
  void initState() {
    super.initState();
    _heartController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 600),
    );
    _heartScale = TweenSequence([
      TweenSequenceItem(tween: Tween(begin: 0.0, end: 1.4), weight: 40),
      TweenSequenceItem(tween: Tween(begin: 1.4, end: 1.0), weight: 20),
      TweenSequenceItem(tween: Tween(begin: 1.0, end: 0.0), weight: 40),
    ]).animate(_heartController);

    _heartController.addStatusListener((status) {
      if (status == AnimationStatus.completed) {
        setState(() => _showHeart = false);
        _heartController.reset();
      }
    });
  }

  @override
  void dispose() {
    _heartController.dispose();
    super.dispose();
  }

  void _doubleTapLike() {
    if (!widget.post.userLiked) {
      ref.read(feedViewModelProvider.notifier).toggleLike(widget.post.id);
    }
    setState(() => _showHeart = true);
    HapticFeedback.lightImpact();
    _heartController.forward();
  }

  Future<void> _sharePost() async {
    final post = widget.post;
    await ShareToChatSheet.show(
      context,
      postId: post.id,
      postCaption: post.content,
      postImageUrl: post.imageUrl,
      authorName: post.author.name,
    );
  }

  void _openImageLightbox(BuildContext context, String imageUrl) {
    Navigator.of(context).push(
      PageRouteBuilder(
        opaque: false,
        barrierColor: Colors.black,
        transitionDuration: const Duration(milliseconds: 220),
        pageBuilder: (_, __, ___) => _ImageLightbox(
          imageUrl: imageUrl,
          heroTag: 'post-image-${widget.post.id}',
          postId: widget.post.id,
          caption: widget.post.content,
          authorName: widget.post.author.name,
          authorUsername: widget.post.author.username,
          authorAvatarUrl: widget.post.author.avatarUrl,
        ),
      ),
    );
  }

  void _shareAsStory(String imageUrl) {
    Navigator.of(context).push(
      MaterialPageRoute(
        fullscreenDialog: true,
        builder: (_) => StoryComposerScreen(initialRemoteUrl: imageUrl),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final post = widget.post;
    return Container(
      margin: const EdgeInsets.only(bottom: 1),
      color: AppColors.nearBlack,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Header
          Padding(
            padding: const EdgeInsets.fromLTRB(14, 14, 14, 10),
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                GestureDetector(
                  onTap: () => context.push('/profile/${post.author.id}'),
                  child: CircleAvatar(
                    radius: 20,
                    backgroundColor: AppColors.slate,
                    backgroundImage: post.author.avatarUrl != null
                        ? NetworkImage(post.author.avatarUrl!)
                        : null,
                    child: post.author.avatarUrl == null
                        ? Text(
                            post.author.name.isNotEmpty
                                ? post.author.name[0].toUpperCase()
                                : '?',
                            style: const TextStyle(color: Colors.white),
                          )
                        : null,
                  ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Flexible(
                            child: Text(
                              post.author.name,
                              style: const TextStyle(
                                color: Colors.white,
                                fontWeight: FontWeight.bold,
                                fontSize: 14,
                              ),
                              overflow: TextOverflow.ellipsis,
                            ),
                          ),
                          if (post.author.isVerified) ...[
                            const SizedBox(width: 3),
                            const Icon(
                              Icons.verified,
                              color: AppColors.electricPurple,
                              size: 15,
                            ),
                          ],
                        ],
                      ),
                      Text(
                        '@${post.author.username} · ${_timeAgo(post.createdAt)}',
                        style: const TextStyle(
                          color: AppColors.coolGray,
                          fontSize: 12,
                        ),
                      ),
                    ],
                  ),
                ),
                IconButton(
                  icon: const Icon(
                    Icons.more_horiz,
                    color: AppColors.coolGray,
                    size: 20,
                  ),
                  padding: EdgeInsets.zero,
                  constraints: const BoxConstraints(),
                  onPressed: () => _showPostOptions(context),
                ),
              ],
            ),
          ),

          // Content text
          if (post.content.isNotEmpty)
            Padding(
              padding: const EdgeInsets.fromLTRB(14, 0, 14, 10),
              child: Text(
                post.content,
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 15,
                  height: 1.45,
                ),
              ),
            ),

          // Image with tap-to-open lightbox + double-tap like
          // Respeita o aspect ratio real da imagem (estilo Instagram).
          if (post.imageUrl != null)
            GestureDetector(
              onTap: () => _openImageLightbox(context, post.imageUrl!),
              onDoubleTap: _doubleTapLike,
              child: Stack(
                alignment: Alignment.center,
                children: [
                  Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 14),
                    child: ClipRRect(
                      borderRadius: BorderRadius.circular(12),
                      child: Hero(
                        tag: 'post-image-${post.id}',
                        child: ConstrainedBox(
                          // Limita altura para não estourar viewport em fotos
                          // muito verticais (proporção máxima 4:5 estilo IG).
                          constraints: BoxConstraints(
                            maxHeight:
                                MediaQuery.of(context).size.width * 1.25,
                          ),
                          child: Image.network(
                            post.imageUrl!,
                            width: double.infinity,
                            fit: BoxFit.cover,
                            loadingBuilder: (ctx, child, progress) {
                              if (progress == null) return child;
                              return AspectRatio(
                                aspectRatio: 4 / 5,
                                child: Container(
                                  color: AppColors.slate,
                                  child: const Center(
                                    child: CircularProgressIndicator(
                                      strokeWidth: 2,
                                      color: AppColors.electricPurple,
                                    ),
                                  ),
                                ),
                              );
                            },
                            errorBuilder: (_, __, ___) => Container(
                              height: 200,
                              color: AppColors.slate,
                              child: const Center(
                                child: Icon(
                                  Icons.broken_image,
                                  color: AppColors.coolGray,
                                ),
                              ),
                            ),
                          ),
                        ),
                      ),
                    ),
                  ),
                  if (_showHeart)
                    ScaleTransition(
                      scale: _heartScale,
                      child: const Icon(
                        Icons.favorite,
                        color: Colors.white,
                        size: 90,
                        shadows: [
                          Shadow(color: Colors.black54, blurRadius: 12),
                        ],
                      ),
                    ),
                ],
              ),
            ),

          // Action bar
          Padding(
            padding: const EdgeInsets.fromLTRB(6, 6, 6, 4),
            child: Row(
              children: [
                _ActionBtn(
                  icon: post.userLiked
                      ? Icons.favorite
                      : Icons.favorite_border,
                  label: _formatCount(post.likesCount),
                  color: post.userLiked ? Colors.red : AppColors.coolGray,
                  onTap: () => ref
                      .read(feedViewModelProvider.notifier)
                      .toggleLike(post.id),
                ),
                _ActionBtn(
                  icon: Icons.chat_bubble_outline,
                  label: _formatCount(post.commentsCount),
                  color: AppColors.coolGray,
                  onTap: () => showModalBottomSheet(
                    context: context,
                    isScrollControlled: true,
                    backgroundColor: Colors.transparent,
                    builder: (_) => CommentsSheet(postId: post.id),
                  ),
                ),
                _ActionBtn(
                  icon: post.userReposted
                      ? Icons.repeat_on_rounded
                      : Icons.repeat,
                  label: _formatCount(post.repostsCount),
                  color: post.userReposted
                      ? AppColors.coolCyan
                      : AppColors.coolGray,
                  onTap: () => _confirmRepost(context, post),
                ),
                _ActionBtn(
                  icon: Icons.bar_chart,
                  label: _formatCount(post.viewsCount),
                  color: AppColors.coolGray,
                  onTap: () {},
                ),
                const Spacer(),
                _ActionBtn(
                  icon: Icons.bookmark_border,
                  label: '',
                  color: AppColors.coolGray,
                  onTap: () => ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text('Post salvo!'),
                      backgroundColor: AppColors.electricPurple,
                      duration: Duration(seconds: 2),
                    ),
                  ),
                ),
                _ActionBtn(
                  icon: Icons.share_outlined,
                  label: '',
                  color: AppColors.coolGray,
                  onTap: _sharePost,
                ),
              ],
            ),
          ),
          const Divider(color: Colors.white10, height: 1),
        ],
      ),
    );
  }

  void _showPostOptions(BuildContext context) {
    final post = widget.post;
    final currentUserId = ref.read(authStateProvider).value?.id;
    final isOwn = currentUserId != null && currentUserId == post.author.id;

    showModalBottomSheet(
      context: context,
      backgroundColor: AppColors.slate,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              width: 40,
              height: 4,
              margin: const EdgeInsets.symmetric(vertical: 12),
              decoration: BoxDecoration(
                color: Colors.white24,
                borderRadius: BorderRadius.circular(2),
              ),
            ),
            ListTile(
              leading: const Icon(Icons.link, color: Colors.white),
              title: const Text('Copiar link',
                  style: TextStyle(color: Colors.white)),
              onTap: () async {
                Navigator.pop(context);
                await Clipboard.setData(
                  ClipboardData(text: 'https://brawe.app/connect/p/${post.id}'),
                );
                if (!context.mounted) return;
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Link copiado!')),
                );
              },
            ),
            if (post.imageUrl != null && post.imageUrl!.isNotEmpty)
              ListTile(
                leading: const Icon(Icons.auto_stories_outlined,
                    color: Colors.white),
                title: const Text('Compartilhar como Story',
                    style: TextStyle(color: Colors.white)),
                onTap: () {
                  Navigator.pop(context);
                  _shareAsStory(post.imageUrl!);
                },
              ),
            if (!isOwn)
              ListTile(
                leading: const Icon(Icons.person_off_outlined,
                    color: Colors.white),
                title: const Text('Deixar de seguir',
                    style: TextStyle(color: Colors.white)),
                onTap: () {
                  Navigator.pop(context);
                  _unfollowAuthor();
                },
              ),
            if (!isOwn)
              ListTile(
                leading: const Icon(Icons.block, color: Colors.white),
                title: const Text('Bloquear usuário',
                    style: TextStyle(color: Colors.white)),
                onTap: () {
                  Navigator.pop(context);
                  _blockAuthor();
                },
              ),
            if (!isOwn)
              ListTile(
                leading: const Icon(Icons.flag_outlined, color: Colors.red),
                title: const Text('Denunciar',
                    style: TextStyle(color: Colors.red)),
                onTap: () {
                  Navigator.pop(context);
                  _reportPost();
                },
              ),
            if (isOwn)
              ListTile(
                leading: const Icon(Icons.delete_outline, color: Colors.red),
                title: const Text('Excluir post',
                    style: TextStyle(color: Colors.red)),
                onTap: () {
                  Navigator.pop(context);
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                        content: Text('Exclusão de posts em breve.')),
                  );
                },
              ),
          ],
        ),
      ),
    );
  }

  Future<void> _unfollowAuthor() async {
    try {
      await ref
          .read(socialRepositoryProvider)
          .unfollowUser(widget.post.author.id);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Você deixou de seguir @${widget.post.author.username}.')),
      );
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Não foi possível deixar de seguir.')),
      );
    }
  }

  Future<void> _blockAuthor() async {
    final author = widget.post.author;
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        backgroundColor: AppColors.slate,
        title: const Text('Bloquear usuário',
            style: TextStyle(color: Colors.white)),
        content: Text(
          'Você não verá mais conteúdo de @${author.username}. Deseja continuar?',
          style: const TextStyle(color: Colors.white70),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancelar',
                style: TextStyle(color: Colors.white70)),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            child:
                const Text('Bloquear', style: TextStyle(color: Colors.red)),
          ),
        ],
      ),
    );
    if (confirmed != true) return;
    try {
      await ref
          .read(socialActionsServiceProvider)
          .blockUser(author.username.isNotEmpty ? author.username : author.id);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('@${author.username} bloqueado.')),
      );
      ref.read(feedViewModelProvider.notifier).refresh();
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Não foi possível bloquear.')),
      );
    }
  }

  Future<void> _reportPost() async {
    final reason = await showModalBottomSheet<String>(
      context: context,
      backgroundColor: AppColors.slate,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: const [
            _ReportReasonHeader(),
            _ReportReasonTile(reason: 'spam', label: 'Spam ou enganoso'),
            _ReportReasonTile(
                reason: 'harassment', label: 'Assédio ou bullying'),
            _ReportReasonTile(
                reason: 'inappropriate',
                label: 'Conteúdo impróprio ou ofensivo'),
            _ReportReasonTile(
                reason: 'impersonation', label: 'Falsa identidade'),
            _ReportReasonTile(reason: 'other', label: 'Outro'),
            SizedBox(height: 8),
          ],
        ),
      ),
    );
    if (reason == null) return;
    try {
      await ref.read(socialActionsServiceProvider).report(
            targetType: 'post',
            targetId: widget.post.id,
            reason: reason,
          );
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
            content: Text('Denúncia enviada. Obrigado por nos avisar.')),
      );
    } catch (_) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Não foi possível enviar a denúncia.')),
      );
    }
  }

  void _confirmRepost(BuildContext context, Post post) {
    showModalBottomSheet(
      context: context,
      backgroundColor: AppColors.slate,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              width: 40,
              height: 4,
              margin: const EdgeInsets.symmetric(vertical: 12),
              decoration: BoxDecoration(
                color: Colors.white24,
                borderRadius: BorderRadius.circular(2),
              ),
            ),
            Padding(
              padding: const EdgeInsets.all(16),
              child: Text(
                post.userReposted
                    ? 'Desfazer repost?'
                    : 'Repostar para seus seguidores?',
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 16,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            ListTile(
              leading:
                  const Icon(Icons.repeat, color: AppColors.coolCyan),
              title: Text(
                post.userReposted ? 'Desfazer repost' : 'Repost',
                style: const TextStyle(color: AppColors.coolCyan),
              ),
              onTap: () => Navigator.pop(context),
            ),
            ListTile(
              leading: const Icon(Icons.edit, color: Colors.white),
              title: const Text('Citar post',
                  style: TextStyle(color: Colors.white)),
              onTap: () => Navigator.pop(context),
            ),
          ],
        ),
      ),
    );
  }

  String _formatCount(int count) {
    if (count >= 1000000) return '${(count / 1000000).toStringAsFixed(1)}M';
    if (count >= 1000) return '${(count / 1000).toStringAsFixed(1)}K';
    return count.toString();
  }

  String _timeAgo(DateTime date) {
    final diff = DateTime.now().difference(date);
    if (diff.inSeconds < 60) return '${diff.inSeconds}s';
    if (diff.inMinutes < 60) return '${diff.inMinutes}m';
    if (diff.inHours < 24) return '${diff.inHours}h';
    if (diff.inDays < 30) return '${diff.inDays}d';
    return '${date.day}/${date.month}/${date.year}';
  }
}

class _ActionBtn extends StatelessWidget {
  const _ActionBtn({
    required this.icon,
    required this.label,
    required this.color,
    required this.onTap,
  });
  final IconData icon;
  final String label;
  final Color color;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(20),
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
        child: Row(
          children: [
            Icon(icon, color: color, size: 19),
            if (label.isNotEmpty) ...[
              const SizedBox(width: 4),
              Text(label, style: TextStyle(color: color, fontSize: 13)),
            ],
          ],
        ),
      ),
    );
  }
}

class _ReportReasonHeader extends StatelessWidget {
  const _ReportReasonHeader();
  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Container(
          width: 40,
          height: 4,
          margin: const EdgeInsets.symmetric(vertical: 12),
          decoration: BoxDecoration(
            color: Colors.white24,
            borderRadius: BorderRadius.circular(2),
          ),
        ),
        const Padding(
          padding: EdgeInsets.fromLTRB(16, 4, 16, 8),
          child: Align(
            alignment: Alignment.centerLeft,
            child: Text(
              'Denunciar post',
              style: TextStyle(
                color: Colors.white,
                fontSize: 16,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
        ),
        const Padding(
          padding: EdgeInsets.fromLTRB(16, 0, 16, 12),
          child: Align(
            alignment: Alignment.centerLeft,
            child: Text(
              'Por que você está denunciando?',
              style: TextStyle(color: Colors.white70, fontSize: 13),
            ),
          ),
        ),
      ],
    );
  }
}

class _ReportReasonTile extends StatelessWidget {
  const _ReportReasonTile({required this.reason, required this.label});
  final String reason;
  final String label;
  @override
  Widget build(BuildContext context) {
    return ListTile(
      title: Text(label, style: const TextStyle(color: Colors.white)),
      trailing: const Icon(Icons.chevron_right, color: Colors.white38),
      onTap: () => Navigator.pop(context, reason),
    );
  }
}

/// 🔍 Lightbox fullscreen para imagens de posts (estilo Instagram).
///
/// Recursos:
/// - Hero animation (`heroTag` = `post-image-{id}`)
/// - Pinch-zoom + pan via InteractiveViewer
/// - Swipe-down (com fade do fundo) ou tap fora para fechar
/// - Double-tap = curtir com floating heart animado (haptic)
/// - Header com autor; footer com caption + ações (like/comment/share)
class _ImageLightbox extends ConsumerStatefulWidget {
  const _ImageLightbox({
    required this.imageUrl,
    required this.heroTag,
    required this.postId,
    required this.caption,
    required this.authorName,
    required this.authorUsername,
    this.authorAvatarUrl,
  });

  final String imageUrl;
  final String heroTag;
  final String postId;
  final String caption;
  final String authorName;
  final String authorUsername;
  final String? authorAvatarUrl;

  @override
  ConsumerState<_ImageLightbox> createState() => _ImageLightboxState();
}

class _ImageLightboxState extends ConsumerState<_ImageLightbox>
    with TickerProviderStateMixin {
  double _dragOffset = 0;
  bool _chromeVisible = true;
  late final AnimationController _heartCtrl;
  late final Animation<double> _heartScale;
  bool _showHeart = false;
  final TransformationController _zoomCtrl = TransformationController();

  @override
  void initState() {
    super.initState();
    _heartCtrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 700),
    );
    _heartScale = TweenSequence<double>([
      TweenSequenceItem<double>(
        tween: Tween<double>(begin: 0.0, end: 1.3)
            .chain(CurveTween(curve: Curves.easeOut)),
        weight: 30,
      ),
      TweenSequenceItem<double>(
        tween: Tween<double>(begin: 1.3, end: 1.0)
            .chain(CurveTween(curve: Curves.easeIn)),
        weight: 20,
      ),
      TweenSequenceItem<double>(
        tween: ConstantTween<double>(1.0),
        weight: 30,
      ),
      TweenSequenceItem<double>(
        tween: Tween<double>(begin: 1.0, end: 0.0)
            .chain(CurveTween(curve: Curves.easeIn)),
        weight: 20,
      ),
    ]).animate(_heartCtrl);

    _heartCtrl.addStatusListener((status) {
      if (status == AnimationStatus.completed && mounted) {
        setState(() => _showHeart = false);
        _heartCtrl.reset();
      }
    });
  }

  @override
  void dispose() {
    _heartCtrl.dispose();
    _zoomCtrl.dispose();
    super.dispose();
  }

  void _doubleTapLike() {
    HapticFeedback.lightImpact();
    // Apenas curte (idempotente do lado do feed; o VM já sabe alternar).
    final vm = ref.read(feedViewModelProvider.notifier);
    // Se já curtiu, double-tap NÃO descurte (comportamento Instagram).
    final state = ref.read(feedViewModelProvider).value;
    final post = state?.firstWhere(
      (p) => p.id == widget.postId,
      orElse: () => state.first,
    );
    if (post != null && !post.userLiked) {
      vm.toggleLike(widget.postId);
    }
    setState(() => _showHeart = true);
    _heartCtrl.forward(from: 0);
  }

  bool get _isZoomed => _zoomCtrl.value.getMaxScaleOnAxis() > 1.05;

  @override
  Widget build(BuildContext context) {
    final feedState = ref.watch(feedViewModelProvider).value;
    final post = feedState?.where((p) => p.id == widget.postId).firstOrNull;
    final userLiked = post?.userLiked ?? false;
    final likesCount = post?.likesCount ?? 0;
    final commentsCount = post?.commentsCount ?? 0;

    final opacity = (1.0 - (_dragOffset.abs() / 300)).clamp(0.0, 1.0);

    return Scaffold(
      backgroundColor: Colors.black.withValues(alpha: opacity),
      body: Stack(
        children: [
          Positioned.fill(
            child: GestureDetector(
              behavior: HitTestBehavior.opaque,
              onTap: () {
                // Toggle UI chrome; só fecha se está no zoom 1:1 e tocou fora
                setState(() => _chromeVisible = !_chromeVisible);
              },
              onDoubleTap: _doubleTapLike,
              onVerticalDragUpdate: _isZoomed
                  ? null
                  : (d) => setState(() => _dragOffset += d.delta.dy),
              onVerticalDragEnd: _isZoomed
                  ? null
                  : (_) {
                      if (_dragOffset.abs() > 100) {
                        Navigator.of(context).pop();
                      } else {
                        setState(() => _dragOffset = 0);
                      }
                    },
              child: Transform.translate(
                offset: Offset(0, _dragOffset),
                child: Center(
                  child: Hero(
                    tag: widget.heroTag,
                    child: InteractiveViewer(
                      transformationController: _zoomCtrl,
                      minScale: 1,
                      maxScale: 5,
                      child: Image.network(
                        widget.imageUrl,
                        fit: BoxFit.contain,
                        errorBuilder: (_, __, ___) => const Icon(
                          Icons.broken_image,
                          color: Colors.white54,
                          size: 80,
                        ),
                      ),
                    ),
                  ),
                ),
              ),
            ),
          ),

          // Floating heart (double-tap feedback)
          if (_showHeart)
            IgnorePointer(
              child: Center(
                child: ScaleTransition(
                  scale: _heartScale,
                  child: const Icon(
                    Icons.favorite,
                    color: Color(0xFFFF3B7E),
                    size: 140,
                    shadows: [Shadow(color: Colors.black54, blurRadius: 18)],
                  ),
                ),
              ),
            ),

          // Top chrome: close + author
          AnimatedOpacity(
            opacity: _chromeVisible ? 1 : 0,
            duration: const Duration(milliseconds: 200),
            child: Container(
              padding: EdgeInsets.only(
                top: MediaQuery.of(context).padding.top + 4,
                left: 8,
                right: 8,
                bottom: 8,
              ),
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topCenter,
                  end: Alignment.bottomCenter,
                  colors: [Colors.black87, Colors.transparent],
                ),
              ),
              child: Row(
                children: [
                  IconButton(
                    icon: const Icon(Icons.close, color: Colors.white),
                    onPressed: () => Navigator.of(context).pop(),
                  ),
                  CircleAvatar(
                    radius: 16,
                    backgroundColor: AppColors.slate,
                    backgroundImage: (widget.authorAvatarUrl != null &&
                            widget.authorAvatarUrl!.isNotEmpty)
                        ? NetworkImage(widget.authorAvatarUrl!)
                        : null,
                    child: (widget.authorAvatarUrl == null ||
                            widget.authorAvatarUrl!.isEmpty)
                        ? Text(
                            widget.authorName.isNotEmpty
                                ? widget.authorName[0].toUpperCase()
                                : '?',
                            style: const TextStyle(
                                color: Colors.white, fontSize: 12),
                          )
                        : null,
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          widget.authorName,
                          style: const TextStyle(
                            color: Colors.white,
                            fontWeight: FontWeight.w600,
                            fontSize: 14,
                          ),
                          overflow: TextOverflow.ellipsis,
                        ),
                        Text(
                          '@${widget.authorUsername}',
                          style: const TextStyle(
                            color: Colors.white70,
                            fontSize: 12,
                          ),
                          overflow: TextOverflow.ellipsis,
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),

          // Bottom chrome: caption + actions
          Positioned(
            bottom: 0,
            left: 0,
            right: 0,
            child: AnimatedOpacity(
              opacity: _chromeVisible ? 1 : 0,
              duration: const Duration(milliseconds: 200),
              child: Container(
                padding: EdgeInsets.fromLTRB(
                  16,
                  16,
                  16,
                  MediaQuery.of(context).padding.bottom + 12,
                ),
                decoration: const BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    colors: [Colors.transparent, Colors.black87],
                  ),
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    if (widget.caption.isNotEmpty)
                      Text(
                        widget.caption,
                        maxLines: 3,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 14,
                          height: 1.4,
                        ),
                      ),
                    if (widget.caption.isNotEmpty)
                      const SizedBox(height: 12),
                    Row(
                      children: [
                        _LightboxAction(
                          icon: userLiked
                              ? Icons.favorite
                              : Icons.favorite_border,
                          color: userLiked
                              ? const Color(0xFFFF3B7E)
                              : Colors.white,
                          label: _formatLightboxCount(likesCount),
                          onTap: () {
                            HapticFeedback.lightImpact();
                            ref
                                .read(feedViewModelProvider.notifier)
                                .toggleLike(widget.postId);
                          },
                        ),
                        const SizedBox(width: 22),
                        _LightboxAction(
                          icon: Icons.mode_comment_outlined,
                          color: Colors.white,
                          label: _formatLightboxCount(commentsCount),
                          onTap: () {
                            Navigator.of(context).pop();
                            // O usuário pode abrir o comentário a partir do card.
                          },
                        ),
                        const SizedBox(width: 22),
                        _LightboxAction(
                          icon: Icons.send_outlined,
                          color: Colors.white,
                          label: 'Enviar',
                          onTap: () {
                            ShareToChatSheet.show(
                              context,
                              postId: widget.postId,
                              postCaption: widget.caption,
                              postImageUrl: widget.imageUrl,
                              authorName: widget.authorName,
                            );
                          },
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

String _formatLightboxCount(int n) {
  if (n < 1000) return '$n';
  if (n < 1000000) return '${(n / 1000).toStringAsFixed(1)}K';
  return '${(n / 1000000).toStringAsFixed(1)}M';
}

class _LightboxAction extends StatelessWidget {
  const _LightboxAction({
    required this.icon,
    required this.color,
    required this.label,
    required this.onTap,
  });
  final IconData icon;
  final Color color;
  final String label;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: Row(
        children: [
          Icon(icon, color: color, size: 26),
          const SizedBox(width: 6),
          Text(
            label,
            style: TextStyle(
              color: color,
              fontSize: 13,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }
}
