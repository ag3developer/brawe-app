# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Patch: Xcode 16+ rejeita #import "Header.h" em umbrella headers de framework.
  # Reescrevemos para o formato angle-bracket APENAS nos pods que sabemos que
  # precisam (Logboard, HaishinKit). NÃO mexer em pods do Firebase/Google
  # (PromisesObjC tem module name != pod name e quebra com esse patch).
  pods_to_patch = %w[Logboard HaishinKit]
  pods_to_patch.each do |pod_name|
    Dir.glob(File.expand_path("Pods/Target Support Files/#{pod_name}/*-umbrella.h", __dir__)).each do |umbrella|
      content = File.read(umbrella)
      patched = content.gsub(/#import\s+"([^"]+\.h)"/) do |_match|
        header = Regexp.last_match(1)
        "#import <#{pod_name}/#{header}>"
      end
      if patched != content
        File.write(umbrella, patched)
        puts "✓ Patched umbrella header: #{pod_name}"
      end
    end
  end

  # Suprime warning "Ignoring duplicate libraries: '-lc++'" do linker do Xcode 15+
  # no target Runner (vários pods referenciam -lc++ ao mesmo tempo).
  installer.aggregate_targets.each do |agg|
    agg.user_project.native_targets.each do |t|
      t.build_configurations.each do |config|
        ldflags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        ldflags = [ldflags] unless ldflags.is_a?(Array)
        unless ldflags.include?('-Wl,-no_warn_duplicate_libraries')
          ldflags << '-Wl,-no_warn_duplicate_libraries'
        end
        config.build_settings['OTHER_LDFLAGS'] = ldflags
      end

      # Adiciona Build Phase que strippa slices de simulador (x86_64) de
      # frameworks embedados. Necessário porque pacotes Dart como `objective_c`
      # distribuem .framework pre-build com slice de simulador, e o Xcode
      # não remove no archive — App Store rejeita com "Unsupported Architectures".
      phase_name = 'Strip Simulator Architectures'
      existing = t.shell_script_build_phases.find { |p| p.name == phase_name }
      script_body = '"${SRCROOT}/scripts/strip_simulator_archs.sh"'
      if existing.nil?
        phase = t.new_shell_script_build_phase(phase_name)
        phase.shell_script = script_body
        phase.show_env_vars_in_log = '0'
        phase.always_out_of_date = '1'
        puts "✓ Added '#{phase_name}' build phase to #{t.name}"
      else
        existing.shell_script = script_body
      end
    end
    agg.user_project.save
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Force minimum deployment target on every pod (alguns vêm com 9.0 e quebram no Xcode 16+).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Garante geração de dSYMs para todos os pods em Release/Profile,
      # evitando o aviso do Crashlytics sobre frameworks sem dSYM.
      if config.name != 'Debug'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end

      # Exclui slice de simulador (x86_64) em builds de device (iphoneos).
      # Sem isso, pods que distribuem .xcframework com slice x86_64 (ex.: objective_c
      # via path_provider_foundation) acabam embedando esse slice no .app de
      # produção e a App Store rejeita com 'Unsupported Architectures' / 'Missing
      # 64-bit support' / 'unsupported platform in the x86_64 slice'.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphoneos*]'] = 'x86_64 i386 armv7'
      config.build_settings['VALID_ARCHS[sdk=iphoneos*]'] = 'arm64'

      # Silencia warnings de código de terceiros (HaishinKit, rtmp_broadcaster, etc.)
      # — não conseguimos consertar libs de fora, e ruído polui o build do app.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # Logboard (dep do HaishinKit) usa #include "Logboard.h" no umbrella header,
      # o que o Xcode trata como erro em frameworks. Desligamos só essa flag.
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      # Permissões necessárias por permission_handler + silencia OpenGLES deprecation
      # do HaishinKit (GLKView).
      # permission_handler: por padrão habilita TODAS as permissões (inclusive
      # AppTrackingTransparency, que injeta NSUserTrackingUsageDescription e
      # quebra a submissão se a App Privacy não declarar tracking).
      # Aqui ligamos só o que usamos e desligamos explicitamente o resto.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=1',
        'PERMISSION_CONTACTS=1',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_LOCATION_WHENINUSE=0',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
        'GLES_SILENCE_DEPRECATION=1',
      ]
    end
  end
end
